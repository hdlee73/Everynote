<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3E6DF0</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/ReaderDialog</item>
        <item name="android:popupMenuStyle">@style/RoundPopupMenu</item>
        <item name="android:editTextBackground">@drawable/field_background</item>
        <item name="android:textAppearanceLargePopupMenu">@style/PopupItemText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/PopupItemText</item>
        <item name="android:listPreferredItemHeightSmall">52dp</item>
        <item name="android:listPreferredItemPaddingLeft">20dp</item>
        <item name="android:listPreferredItemPaddingRight">20dp</item>
    </style>
    <style name="ReaderDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">#3E6DF0</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:editTextBackground">@drawable/field_background</item>
        <item name="android:textColorPrimary">#1C1C1E</item>
        <item name="android:textColorSecondary">#6C6C70</item>
    </style>
    <style name="DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="DialogButton" parent="android:Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#3E6DF0</item>
        <item name="android:minWidth">64dp</item>
    </style>
    <style name="RoundPopupMenu" parent="android:Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_surface</item>
        <item name="android:popupElevation">14dp</item>
        <item name="android:overlapAnchor">true</item>
    </style>
    <style name="PopupItemText" parent="android:TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
    <style name="SheetDialog" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/SheetAnimation</item>
        <item name="android:backgroundDimAmount">0.36</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:colorAccent">#3E6DF0</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
